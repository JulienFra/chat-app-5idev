generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  displayName  String       @unique // pseudo façon Discord : un seul utilisateur par pseudo
  plan         Plan         @default(FREE) // abonnement porté par le compte du propriétaire
  createdAt    DateTime     @default(now())

  memberships         Membership[]
  messages            Message[]
  sentInvitations     Invitation[] @relation("SentInvitations")
  receivedInvitations Invitation[] @relation("ReceivedInvitations")
}

model Conversation {
  id          String       @id @default(uuid())
  isGroup     Boolean      @default(false)
  name        String?      // utile uniquement si isGroup = true
  createdAt   DateTime     @default(now())

  memberships Membership[]
  messages    Message[]
  invitations Invitation[]
}

model Membership {
  id             String       @id @default(uuid())
  role           Role         @default(MEMBER)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?    // dernière lecture de la conversation (null = jamais lue)

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  @@unique([userId, conversationId]) // un utilisateur ne peut être membre qu'une fois d'une même conversation
}

model Message {
  id             String       @id @default(uuid())
  content        String
  createdAt      DateTime     @default(now())

  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId       String

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
}

// Invitation à rejoindre un groupe : il faut l'accepter pour devenir membre.
// Une invitation PENDING de plus de 7 jours est considérée comme expirée.
model Invitation {
  id          String           @id @default(uuid())
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?        // date d'acceptation, de refus ou d'annulation

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  inviter   User   @relation("SentInvitations", fields: [inviterId], references: [id], onDelete: Cascade)
  inviterId String

  invitee   User   @relation("ReceivedInvitations", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviteeId String

  @@index([inviteeId, status])      // « Mes invitations »
  @@index([conversationId, status]) // invitations en attente d'un groupe
  @@index([inviterId, createdAt])   // limite de 20 envois par heure
}

enum Role {
  MEMBER
  ADMIN
}

enum Plan {
  FREE
  PREMIUM
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}