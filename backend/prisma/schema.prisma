generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  displayName  String       @unique // pseudo façon Discord : un seul utilisateur par pseudo
  plan         Plan         @default(FREE) // abonnement porté par le compte du propriétaire
  createdAt    DateTime     @default(now())

  memberships         Membership[]
  messages            Message[]
  ownedTeams          Team[]       // équipes dont il est le propriétaire (= CEO)
  teamMemberships     TeamMember[] // équipes dont il fait partie, avec son rôle
  createdEvents       Event[]
  sentInvitations     Invitation[] @relation("SentInvitations")
  receivedInvitations Invitation[] @relation("ReceivedInvitations")
}

// Une structure e-sport (ex : « KCorp Valorant »)
model Team {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  // Le propriétaire est l'unique CEO. Son plan (Free/Premium) fixe les limites.
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  members       TeamMember[]
  conversations Conversation[] // #général, #admin, salons d'events
  events        Event[]
  invitations   Invitation[]
}

model TeamMember {
  id       String   @id @default(uuid())
  role     TeamRole @default(PLAYER)
  joinedAt DateTime @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([teamId, userId]) // on n'est qu'une fois dans une équipe
}

model Conversation {
  id          String           @id @default(uuid())
  type        ConversationType @default(DIRECT)
  isGroup     Boolean          @default(false) // true pour les salons d'équipe (conservé pour le code existant)
  name        String?          // nom du salon : général, admin, scrim-vitality-08-10…
  createdAt   DateTime         @default(now())

  team   Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String? // null pour les messages privés

  event       Event?           // rempli si c'est le salon dédié d'un event
  memberships Membership[]     // qui voit ce salon (ex : #admin = CEO + coachs)
  messages    Message[]
}

model Membership {
  id             String       @id @default(uuid())
  role           Role         @default(MEMBER)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?    // dernière lecture de la conversation (null = jamais lue)

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  @@unique([userId, conversationId]) // un utilisateur ne peut être membre qu'une fois d'une même conversation
}

model Message {
  id             String       @id @default(uuid())
  content        String
  createdAt      DateTime     @default(now())

  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId       String

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
}

// Invitation à rejoindre une équipe : il faut l'accepter pour devenir membre.
// Une invitation PENDING de plus de 7 jours est considérée comme expirée.
model Invitation {
  id          String           @id @default(uuid())
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?        // date d'acceptation, de refus ou d'annulation

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  inviter   User   @relation("SentInvitations", fields: [inviterId], references: [id], onDelete: Cascade)
  inviterId String

  invitee   User   @relation("ReceivedInvitations", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviteeId String

  @@index([inviteeId, status])    // « Mes invitations »
  @@index([teamId, status])       // invitations en attente d'une équipe
  @@index([inviterId, createdAt]) // limite de 20 envois par heure
}

// Un scrim ou un match officiel, affiché dans le calendrier de l'équipe
model Event {
  id        String    @id @default(uuid())
  type      EventType
  opponent  String    // ex : « Vitality », sert aussi au nom du salon
  startsAt  DateTime
  createdAt DateTime  @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String

  // Salon dédié : uniquement en Premium (null en Free)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  conversationId String?       @unique

  @@index([teamId, startsAt]) // le calendrier filtre par équipe et par date
}

enum Role {
  MEMBER
  ADMIN
}

enum Plan {
  FREE
  PREMIUM
}

enum TeamRole {
  CEO
  COACH
  PLAYER
}

enum ConversationType {
  DIRECT  // message privé entre deux joueurs
  GENERAL // #général d'une équipe (tout le monde)
  ADMIN   // #admin d'une équipe (CEO + coachs, Premium)
  EVENT   // salon dédié à un scrim ou un match (Premium)
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum EventType {
  SCRIM
  MATCH
}